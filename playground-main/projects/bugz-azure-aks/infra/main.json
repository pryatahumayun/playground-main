          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "5054729620924221359"
            }
          },
          "parameters": {
            "clusterName": {
              "type": "string"
            },
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]"
            },
            "subnetId": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "nodeVmSize": {
              "type": "string",
              "defaultValue": "Standard_D2s_v7"
            },
            "nodeCount": {
              "type": "int",
              "defaultValue": 1,
              "minValue": 1
            }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerService/managedClusters",
              "apiVersion": "2024-02-01",
              "name": "[parameters('clusterName')]",
              "location": "[parameters('location')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "dnsPrefix": "[parameters('clusterName')]",
                "enableRBAC": true,
                "agentPoolProfiles": [
                  {
                    "name": "systempool",
                    "count": "[parameters('nodeCount')]",
                    "vmSize": "[parameters('nodeVmSize')]",
                    "osType": "Linux",
                    "osSKU": "Ubuntu",
                    "mode": "System",
                    "type": "VirtualMachineScaleSets",
                    "vnetSubnetID": "[parameters('subnetId')]"
